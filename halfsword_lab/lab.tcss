/* Clean dashboard: sidebar navigation, flat cards, compact one-line controls. */

Screen { background: $background; }

#shell { height: 1fr; }

/* ---------------------------------------------------------------- sidebar */
#sidebar {
    width: 30;
    background: #0f0f18;
    border-right: tall #1f1f2e;
    padding: 1 1 0 1;
}
#brand { height: 3; padding: 0 1; margin-bottom: 1; }
#nav {
    height: 1fr;
    background: #0f0f18;
    border: none;
    padding: 0;
}
#nav > .option-list--option { padding: 0 1; }
#nav > .option-list--option-highlighted {
    background: $primary 22%;
    color: $foreground;
    text-style: bold;
}
#nav:focus > .option-list--option-highlighted { background: $primary 35%; }
#side-status { height: auto; padding: 1 1; color: $foreground 60%; }

/* ---------------------------------------------------------------- main area */
#main { padding: 1 2 0 2; }
#page-title { height: 3; margin-bottom: 1; }
#pages { height: 1fr; }

.section { padding: 1 0 0 0; height: auto; }
.hint { color: $foreground 45%; padding: 1 0 0 0; height: auto; }
.bar { height: auto; margin-top: 1; }
.bar > * { margin-right: 1; }
.panel {
    background: $background;
    border: round #26263a;
    padding: 0 1;
}

Button { min-width: 0; }
Button.-primary { text-style: bold; }

/* ---------------------------------------------------------------- home */
#cards { grid-size: 2; grid-gutter: 1 2; height: auto; }
.card {
    background: $background;
    border: round #2a2a40;
    padding: 1 2;
    height: auto;
}
.card:hover { border: round $primary 70%; }
.card-title { height: 1; }
.card-desc { height: auto; margin: 1 0; }
.card-stat { height: 1; margin-bottom: 1; }
#home-backups { height: auto; max-height: 8; background: $background; }

/* ---------------------------------------------------------------- save editor */
#slots { width: 36; margin-right: 1; }
#slot-list { height: 1fr; background: $background; border: none; }
#slot-list > .option-list--option-highlighted { background: $primary 25%; }
#save-main { width: 1fr; }
#save-head { height: auto; min-height: 2; }
#se-filter { width: 1fr; }
#se-group { width: 24; }
#se-table { height: 1fr; }

/* ---------------------------------------------------------------- live lab */
#char-col { width: 38; margin-right: 1; }
#chars { height: 1fr; background: $background; border: none; }
#chars > .option-list--option-highlighted { background: $primary 25%; }
#world { height: 1; }
#char-main { width: 1fr; }
#char-title { height: 2; }
#body-info { padding: 1 0 0 0; height: auto; }
.lbl { width: 8; text-style: bold; color: $secondary; }
.num { width: 10; }
DataTable { height: 1fr; min-height: 5; background: $surface; }
#stat-filter { margin: 1 0; }
.spawn { width: 1fr; }
.count { width: 6; }
#goofy { grid-size: 3; grid-gutter: 1 2; padding: 1 0; height: auto; }
#goofy Button { width: 100%; }

/* ---------------------------------------------------------------- mods */
.mod {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface;
    border-left: tall $primary 40%;
}
.mod:hover { border-left: tall $secondary; }
.mod Switch { margin-right: 1; }
.mod-text { width: 1fr; height: auto; }
.plabel { padding: 1 1 0 2; color: $foreground 60%; }
.param { width: 8; margin-top: 1; }
#gravity { width: 24; margin-top: 1; }

/* ---------------------------------------------------------------- backups, setup, log */
#backup-head { height: auto; padding-bottom: 1; }
#backup-table { height: 1fr; }
#setup-status { height: auto; }
#game-path { width: 1fr; }
#log { background: $surface; padding: 0 1; }

/* ---------------------------------------------------------------- dialogs */
BackupPrompt, EditValue, Confirm { align: center middle; background: $background 70%; }
#dialog {
    width: 70;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}
#dialog.prompt { border: round $secondary; }
#dialog .change { padding: 1 0 0 0; height: auto; }
#dialog Input { margin-top: 1; }
